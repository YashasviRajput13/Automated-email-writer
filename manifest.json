{
  "name": "Email Extension Assistant",
  "description": "AI-Powered email reply generator",
  "version": "1.0",
  "manifest_version": 3,

  "permissions": [
    "activeTab",
    "storage"
  ],

  "host_permissions": [
    "https://mail.google.com/*",
    "https://automated-email-writer.onrender.com/*"
  ],

  "icons": {
    "128": "icons/logo.png"
  },

  "content_scripts": [
    {
      "matches": [
        "https://mail.google.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_end"
    }
  ],

  "web_accessible_resources": [
    {
      "resources": [
        "icons/*"
      ],
      "matches": [
        "https://mail.google.com/*"
      ]
    }
  ],

  "action": {
    "default_title": "Email Extension Assistant",
    "default_icon": {
      "128": "icons/logo.png"
    }
  }
}